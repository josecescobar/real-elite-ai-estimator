# Database (Turso / libSQL)
# Hosted:  libsql://<your-db>.turso.io   Local dev:  file:./prisma/dev.db
TURSO_DATABASE_URL=file:./prisma/dev.db
# Required for hosted Turso, leave empty for file: URLs
TURSO_AUTH_TOKEN=

# NextAuth — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# AI providers for "AI Suggest" — set at least one to enable AI features
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
